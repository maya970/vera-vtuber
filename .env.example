# 复制为 .env 后填写。这个文件只留在你自己的电脑上，不要发到网上，也不要打包给别人。
DEEPSEEK_API_KEY=
# B 站登录 Cookie（可选）。填了才能稳定收到聊天弹幕。不要把填好的 .env 上传。
BILI_SESSDATA=
BILI_BUVID3=
# 直播间号（短号或真实房间号都可以）。只写在这里，不要写进会上传的文件。
BILI_ROOM_ID=
# 可选。只有你自己有书目网站、又想在讲书模式里记下网址时才填。
BOOKBOX_BASE=
# 可选。要一起打开的游戏程序。只留在这台电脑上。
GAME_EXE=
# 弹幕直播间。房间号、频道名或直播网址都写在这里，不要写进会上传的文件。
CHAT_TARGET=
# 可选。Twitch 公开聊天不填也能听。只有匿名方式失败时才填 oauth 令牌。
TWITCH_TOKEN=
# 可选。YouTube 公开直播不填也能听。有自己的 API Key 时可以填在这里。
YOUTUBE_API_KEY=
